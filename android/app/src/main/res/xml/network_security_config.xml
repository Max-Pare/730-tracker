<?xml version="1.0" encoding="utf-8"?>
<!--
  730 Tracker is self-hosted. Plain HTTP is allowed so the app can reach a
  server on the home network (the app warns when it is used), and user-installed
  CAs are trusted so a server with a private certificate authority works.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
